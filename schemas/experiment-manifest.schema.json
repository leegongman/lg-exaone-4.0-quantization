{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Experiment Manifest",
  "description": "Metadata schema for sanitized experiment summaries. No score, dataset, checkpoint, or secret fields are permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "method_family",
    "evidence_level",
    "public_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "status": {
      "enum": [
        "attempted",
        "partial",
        "failed",
        "exploratory",
        "local-benchmark",
        "unverified-internal"
      ]
    },
    "method_family": {
      "enum": [
        "gptq",
        "awq",
        "smoothquant",
        "omniquant",
        "mixed-precision",
        "low-bit-format",
        "fine-tuning",
        "distillation",
        "vllm-runtime"
      ]
    },
    "evidence_level": {
      "enum": [
        "reviewed-local-evidence",
        "implementation-evidence-reviewed",
        "internal-record",
        "research-survey"
      ]
    },
    "public_summary": {
      "type": "string",
      "minLength": 1
    },
    "target_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "quantization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight_bits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "activation_bits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "group_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_status": {
          "enum": [
            "not-distributed",
            "not-applicable"
          ]
        },
        "sample_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sequence_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "enum": [
            "transformers",
            "vllm",
            "other"
          ]
        },
        "artifact_status": {
          "const": "not-distributed"
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "not-published",
            "local-benchmark"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
