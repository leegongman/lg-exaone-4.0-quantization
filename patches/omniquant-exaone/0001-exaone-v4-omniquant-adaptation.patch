+
+    @classmethod
+    def from_config(cls, config: dict[str, Any]) -> "OmniActivationRealConfig":
+        return cls(config)
+
+    @classmethod
+    def from_model_dir(
+        cls,
+        model_dir: str,
+        config_dict: dict[str, Any] | None = None,
+    ) -> "OmniActivationRealConfig":
+        if config_dict is None:
+            config = json.loads((Path(model_dir) / "config.json").read_text())
